{
  "name": "@pulse/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "owner-token": "tsx --env-file-if-exists=.env src/cli/ownerToken.ts"
  },
  "dependencies": {
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "msw": "^2.15.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.5"
  }
}
